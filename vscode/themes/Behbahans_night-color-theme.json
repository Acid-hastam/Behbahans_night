  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#5A6275", "fontStyle": "italic" }
    },
    {
      "name": "Keywords & Storage",
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#9D65FF" }
    },
    {
      "name": "Operators & Punctuation",
      "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator"],
      "settings": { "foreground": "#67E8F9" }
    },
    {
      "name": "Functions & Methods",
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#38BDF8" }
    },
    {
      "name": "Classes, Types & Interfaces",
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": { "foreground": "#FBBF24" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#3BD671" }
    },
    {
      "name": "Numbers & Constants",
      "scope": ["constant.numeric", "constant.language", "support.constant"],
      "settings": { "foreground": "#C499FF" }
    },
    {
      "name": "Variables & Parameters",
      "scope": ["variable", "variable.parameter", "variable.other"],
      "settings": { "foreground": "#F0F2F5" }
    },
    {
      "name": "Object Properties & Attributes",
      "scope": ["variable.other.property", "entity.other.attribute-name", "support.type.property-name"],
      "settings": { "foreground": "#5EEAD4" }
    },
    {
      "name": "HTML / JSX Tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#FF5C6C" }
    },
    {
      "name": "Markdown Headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#38BDF8", "fontStyle": "bold" }
    },
    {
      "name": "Markdown Links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#67E8F9" }
    }
  ]
}
