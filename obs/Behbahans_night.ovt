/* ====================================================================
 * Behbahans Night - OBS Studio Theme
 * Variant Theme extending Yami (OBS Studio 30.2+ / 31+)
 * Aesthetic: Deep Midnight Obsidian & Glowing Sky-Blue (#38BDF8)
 * ==================================================================== */

@OBSThemeMeta {
    name: 'Behbahans Night';
    id: 'com.acid-hastam.BehbahansNight';
    extends: 'com.obsproject.Yami';
    author: 'Acid-hastam';
    dark: 'true';
}

@OBSThemeVars {
    /* Core Surface & Midnight Navy Palette */
    --grey8: #08090C;
    --grey7: #0B0E14;
    --grey6: #121622;
    --grey5: #141824;
    --grey4: #1E2538;
    --grey3: #242F45;
    --grey2: #283149;
    --grey1: #334155;

    /* Primary Neon Sky-Blue Accent Scale */
    --blue1: #67E8F9;
    --blue2: #38BDF8;
    --blue3: #0284C7;
    --blue4: #0369A1;
    --blue5: #075985;
    --blue6: #0C4A6E;

    --teal1: #67E8F9;
    --teal2: #38BDF8;
    --teal3: #0284C7;
    --teal4: #0369A1;
    --teal5: #075985;
    --teal6: #0C4A6E;

    /* Functional Accent Colors */
    --red1: #FF7A88;
    --red2: #FF5C6C;
    --red3: #EF4444;
    --red4: #DC2626;
    --red5: #991B1B;
    --red6: #7F1D1D;

    --green1: #5EEAD4;
    --green2: #3BD671;
    --green3: #10B981;
    --green4: #059669;
    --green5: #047857;
    --green6: #064E3B;

    --yellow1: #FDE047;
    --yellow2: #FBBF24;
    --yellow3: #F59E0B;
    --yellow4: #D97706;
    --yellow5: #B45309;
    --yellow6: #78350F;

    --purple1: #C499FF;
    --purple2: #9D65FF;
    --purple3: #7C3AED;
    --purple4: #6D28D9;
    --purple5: #5B21B6;
    --purple6: #4C1D95;

    /* Foreground & Text Hierarchy */
    --white1: #FFFFFF;
    --white2: #F0F2F5;
    --white3: #E2E8F0;
    --white4: #A0AAB8;
    --white5: #7E8696;

    --black1: #08090C;
    --black2: #0D1017;
    --black3: #141824;
    --black4: #1E2538;
    --black5: #283149;

    /* Mapped Base Theme Tokens */
    --bg_window: var(--grey7);
    --bg_base: var(--grey6);
    --bg_preview: var(--grey8);

    --primary: var(--blue3);
    --primary_light: var(--blue2);
    --primary_lighter: var(--blue1);
    --primary_dark: var(--blue4);
    --primary_darker: var(--blue5);

    --text: var(--white2);
    --text_light: var(--white1);
    --text_muted: var(--white5);
    --text_disabled: var(--white5);
    --text_inactive: #A0AAB8;

    --highlight_color: var(--blue2);
    --border_color: var(--grey4);

    /* Inputs, Buttons, Tabs & Scrollbars */
    --input_bg: var(--grey5);
    --input_bg_hover: var(--grey7);
    --input_bg_focus: var(--grey8);
    --input_border: var(--grey4);
    --input_border_hover: var(--grey2);
    --input_border_focus: var(--blue2);

    --button_bg: var(--grey5);
    --button_bg_hover: var(--grey4);
    --button_bg_down: var(--grey7);
    --button_bg_disabled: var(--grey6);
    --button_border: var(--grey4);
    --button_border_hover: var(--blue2);
    --button_border_focus: var(--blue2);

    --list_item_bg_selected: var(--grey3);
    --list_item_bg_hover: var(--grey4);

    --tab_bg: var(--grey6);
    --tab_bg_hover: var(--grey4);
    --tab_bg_down: var(--blue3);
    --tab_bg_disabled: var(--grey6);
    --tab_border: var(--grey4);
    --tab_border_hover: var(--grey2);
    --tab_border_focus: var(--blue1);
    --tab_border_selected: var(--blue2);

    --scrollbar_bg: transparent;
    --scrollbar_handle: var(--grey4);
    --scrollbar_hover: var(--grey2);
    --scrollbar_down: var(--blue3);
    --scrollbar_border: var(--grey4);

    --palette_window: var(--bg_window);
    --palette_windowText: var(--text);
    --palette_base: var(--bg_base);
    --palette_light: var(--grey2);
    --palette_mid: var(--grey7);
    --palette_dark: var(--grey6);
}

/* Additional Midnight Obsidian Polish */
QDockWidget::title {
    background-color: #090C10;
    border-bottom: 1px solid #1E2538;
}

QMenu {
    background-color: #121622;
    border: 1px solid #1E2538;
}

QMenu::item:selected {
    background-color: #242F45;
    color: #38BDF8;
}

QStatusBar {
    background-color: #08090C;
    border-top: 1px solid #1E2538;
}

QToolTip {
    background-color: #141824;
    color: #F0F2F5;
    border: 1px solid #38BDF8;
}
